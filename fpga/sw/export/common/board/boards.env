# Replace all four serials with yours: ./list_boards.sh prints them.
# FTDI serials of the two C232HM JTAG cables. Find yours with
#   lsusb -v -d 0403:6014 | grep iSerial
# (unplug one cable to tell them apart), and swap if the boards are reversed.
INITIATOR_SERIAL=FTA6JVAK
RESPONDER_SERIAL=FTA6GPSN
# Digilent USB serials of the two Arty boards (their USB-UART consoles), used
# by run_pair.sh to find each console tty. Find with
#   cat /sys/bus/usb/devices/*/serial   (or lsusb -v -d 0403:6010 | grep iSerial)
INITIATOR_CONSOLE=210319B269F6
RESPONDER_CONSOLE=210319B4A439
